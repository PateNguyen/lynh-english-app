    // GENERATE 200 LESSONS DYNAMICALLY
    function generateCurriculum() {
        const curriculum = { basic: [], medium: [], advanced: [] };

        ['basic', 'medium', 'advanced'].forEach(lvl => {
            const vocabList = VOCAB_BANKS[lvl];

            for (let i = 1; i <= 200; i++) {
                const topicKey = TOPICS[(i - 1) % TOPICS.length];
                const topicName = TOPIC_NAMES[topicKey];

                // Generate 20 progressive items for this lesson
                const items = [];
                for (let q = 1; q <= 20; q++) {
                    const vocab = vocabList[(q - 1) % vocabList.length];
                    const diffScore = Math.min(20, Math.floor((i / 10) + (q / 2))); // difficulty curve

                    // 1. Listening Question
                    const listeningText = `This is practice sentence number ${q} involving ${vocab.en} for your lesson.`;
                    
                    // 2. MCQ Options
                    const options = [
                        vocab.vi,
                        `Ý nghĩa phụ liên quan đến ${vocab.p}`,
                        `Cấu trúc sai ngữ pháp`,
                        `Từ trái nghĩa cơ bản`
                    ].sort(() => 0.5 - Math.random());

                    // 3. Sentence Writing
                    const sentenceEn = `We should ${vocab.en} carefully during our project work.`;
                    const sentenceVi = `Chúng ta nên ${vocab.vi} một cách cẩn thận trong công việc.`;

                    items.push({
                        qNum: q,
                        difficulty: diffScore,
                        vocab: vocab,
                        listeningText: listeningText,
                        blankWord: vocab.en,
                        mcqQuestion: `Từ "${vocab.en}" (${vocab.p}) có nghĩa tiếng Việt là gì?`,
                        mcqOptions: options,
                        correctMcq: vocab.vi,
                        writingPrompt: sentenceVi,
                        writingCorrect: sentenceEn,
                        explanation: `Từ "${vocab.en}" là ${vocab.p} có nghĩa là "${vocab.vi}". Sử dụng phổ biến trong ngữ cảnh ${topicName}.`
                    });
                }

                curriculum[lvl].push({
                    id: `${lvl}_lesson_${i}`,
                    lessonNum: i,
                    title: `Bài ${i}: ${topicName} (Cấp độ ${i})`,
                    topic: topicKey,
                    difficulty: Math.ceil(i / 10),
                    isUnlocked: i === 1 || i <= 5, // Unlock first few lessons
                    progress: i === 1 ? 100 : 0,
                    score: i === 1 ? '18/20' : '0/20',
                    items: items
                });
            }
        });

        return curriculum;
    }

    const DATABASE = generateCurriculum();

    // Sound Generator (Web Audio API)
    function initAudioContext() {
        if (!audioContext) {
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioContext.state === 'suspended') {
            audioContext.resume();
        }
        isAudioEnabled = true;
        document.getElementById('audio-status').innerText = "Âm Thanh Bật";
        document.getElementById('audio-icon').className = "fa-solid fa-volume-high";
    }

    function toggleAudioEngine() {
        if (!isAudioEnabled) {
            initAudioContext();
            playEffect('success');
        } else {
            stopAllAudio();
            isAudioEnabled = false;
            document.getElementById('audio-status').innerText = "Âm Thanh Tắt";
            document.getElementById('audio-icon').className = "fa-solid fa-volume-xmark";
        }
    }

    function stopAllAudio() {
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
        }
    }

    function playEffect(type) {
        if (!isAudioEnabled) return;
        try {
            initAudioContext();
            const osc = audioContext.createOscillator();
            const gain = audioContext.createGain();
            osc.connect(gain);
            gain.connect(audioContext.destination);

            const now = audioContext.currentTime;

            if (type === 'success') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, now);
                osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.1);
                osc.frequency.exponentialRampToValueAtTime(783.99, now + 0.2);
                gain.gain.setValueAtTime(0.25, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
                osc.start(now);
                osc.stop(now + 0.35);
            } else if (type === 'error') {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(220, now);
                osc.frequency.linearRampToValueAtTime(140, now + 0.2);
                gain.gain.setValueAtTime(0.25, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                osc.start(now);
                osc.stop(now + 0.25);
            } else if (type === 'click') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(450, now);
                gain.gain.setValueAtTime(0.08, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.04);
                osc.start(now);
                osc.stop(now + 0.04);
            } else if (type === 'ring') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(440, now);
                osc.frequency.setValueAtTime(880, now + 0.12);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                osc.start(now);
                osc.stop(now + 0.25);
            }
        } catch (e) {
            console.log("Audio FX error:", e);
        }
    }

    // Native Web Speech Synthesis
    function speakText(text, lang = preferredVoiceLang, rate = currentSpeed, onEndCallback = null) {
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = lang;
            utterance.rate = rate;

            utterance.onstart = () => {
                const avatar = document.getElementById('avatar-container');
                if (avatar) avatar.classList.add('speaking');
            };

            utterance.onend = () => {
                const avatar = document.getElementById('avatar-container');
                if (avatar) avatar.classList.remove('speaking');
                if (onEndCallback) onEndCallback();
            };

            utterance.onerror = () => {
                const avatar = document.getElementById('avatar-container');
                if (avatar) avatar.classList.remove('speaking');
            };

            window.speechSynthesis.speak(utterance);
        }
    }

