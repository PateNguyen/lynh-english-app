<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lynh Học Tiếng Anh - Hệ Thống 200 Bài Học & Âm Thanh Realtime</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --primary-color: #6366F1;
            --primary-light: #EEF2FF;
            --secondary-color: #10B981;
            --accent-color: #F59E0B;
            --bg-color: #F8FAFC;
            --card-bg: #FFFFFF;
            --text-dark: #0F172A;
            --text-muted: #64748B;
            --border-color: #E2E8F0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: #0F172A;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* Container mô phỏng Điện thoại di động */
        .phone-container {
            width: 100%;
            max-width: 440px;
            height: 880px;
            background-color: var(--bg-color);
            border-radius: 44px;
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            border: 8px solid #1E293B;
        }

        /* Header */
        .app-header {
            background: linear-gradient(135deg, #4F46E5, #7C3AED);
            color: white;
            padding: 20px 18px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
            z-index: 10;
        }

        .app-title {
            font-size: 1.05rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .user-level-badge {
            background: rgba(255, 255, 255, 0.22);
            backdrop-filter: blur(8px);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        /* App Body & Animations */
        .app-body {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            scroll-behavior: smooth;
        }

        .section-title {
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Level Selector Cards */
        .level-selector {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-bottom: 16px;
        }

        .level-card {
            background: var(--card-bg);
            border: 2px solid var(--border-color);
            border-radius: 14px;
            padding: 10px 4px;
            text-align: center;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .level-card:hover {
            transform: translateY(-2px);
        }

        .level-card.active {
            border-color: var(--primary-color);
            background-color: var(--primary-light);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.15);
            transform: scale(1.02);
        }

        .level-card h4 {
            font-size: 0.78rem;
            color: var(--text-dark);
            font-weight: 700;
        }

        .level-card p {
            font-size: 0.65rem;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* Topic Chips */
        .topic-scroll {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 8px;
            margin-bottom: 12px;
            scrollbar-width: none;
        }
        .topic-scroll::-webkit-scrollbar { display: none; }

        .topic-chip {
            white-space: nowrap;
            background: white;
            border: 1px solid var(--border-color);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .topic-chip.active {
            background: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
            box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
        }

        /* Skill Cards */
        .skills-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 16px;
        }

        .skill-card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
            cursor: pointer;
            transition: all 0.2s ease;
            border: 1px solid rgba(226, 232, 240, 0.9);
        }

        .skill-card:active { transform: scale(0.98); }

        .skill-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            transition: transform 0.3s;
        }

        .skill-reading .skill-icon { background: #FEF3C7; color: #D97706; }
        .skill-listening .skill-icon { background: #E0E7FF; color: #4F46E5; }
        .skill-writing .skill-icon { background: #D1FAE5; color: #059669; }
        .skill-call .skill-icon { background: #FCE7F3; color: #DB2777; }

        .skill-info { flex: 1; }
        .skill-info h3 { font-size: 0.88rem; color: var(--text-dark); font-weight: 700; }
        .skill-info p { font-size: 0.72rem; color: var(--text-muted); margin-top: 2px; }

        /* Screens */
        .screen {
            display: none;
            animation: fadeIn 0.3s ease-in-out;
        }

        .screen.active { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Interactive Box Component */
        .interactive-box {
            background: white;
            border-radius: 18px;
            padding: 16px;
            margin-bottom: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.02);
            border: 1px solid var(--border-color);
        }

        .audio-player {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--primary-light);
            padding: 10px 12px;
            border-radius: 12px;
            margin-bottom: 12px;
        }

        .play-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--primary-color);
            color: white;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s;
        }

        .play-btn:active { transform: scale(0.9); }

        .speed-btn {
            background: white;
            border: 1px solid var(--border-color);
            padding: 4px 8px;
            border-radius: 8px;
            font-size: 0.7rem;
            font-weight: 600;
            cursor: pointer;
        }

        .clickable-word {
            cursor: pointer;
            padding: 2px 6px;
            border-radius: 6px;
            font-weight: 600;
            color: var(--primary-color);
            background: var(--primary-light);
            display: inline-flex;
            align-items: center;
            gap: 3px;
            margin: 2px 1px;
            font-size: 0.85rem;
        }

        .clickable-word:hover { background-color: #C7D2FE; }

        .ai-feedback {
            background: #F0FDF4;
            border-left: 4px solid var(--secondary-color);
            padding: 12px 14px;
            border-radius: 0 12px 12px 0;
            margin-top: 12px;
            font-size: 0.8rem;
            animation: slideUp 0.25s ease;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* AI Voice Call Screen */
        .call-screen {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle at center, #1E1B4B 0%, #0F172A 100%);
            color: white;
            z-index: 100;
            display: none;
            flex-direction: column;
            justify-content: space-between;
            padding: 36px 20px 24px;
        }

        .call-screen.active { display: flex; }

        .ai-avatar-container {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 20px auto 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .ai-wave {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: rgba(99, 102, 241, 0.3);
            animation: soundWave 2s infinite ease-out;
            display: none;
        }

        .ai-avatar-container.speaking .ai-wave { display: block; }
        .ai-wave:nth-child(2) { animation-delay: 0.6s; }
        .ai-wave:nth-child(3) { animation-delay: 1.2s; }

        @keyframes soundWave {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(1.6); opacity: 0; }
        }

        .ai-avatar-core {
            position: relative;
            width: 85px;
            height: 85px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6366F1, #EC4899);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            box-shadow: 0 0 25px rgba(236, 72, 153, 0.5);
            z-index: 2;
        }

        .transcript-box {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(12px);
            padding: 14px;
            border-radius: 16px;
            font-size: 0.82rem;
            max-height: 180px;
            overflow-y: auto;
            margin-bottom: 16px;
            border: 1px solid rgba(255,255,255,0.1);
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .call-controls {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 5px;
        }

        .btn-call-action {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            border: none;
            color: white;
            font-size: 1.15rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }

        .btn-end { background: #EF4444; }
        .btn-hint { background: #F59E0B; }
        .btn-mic { background: #10B981; }

        /* Navigation Bar */
        .nav-bar {
            background: white;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-around;
            padding: 8px 0 12px;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 0.68rem;
            color: var(--text-muted);
            cursor: pointer;
        }

        .nav-item.active { color: var(--primary-color); font-weight: 700; }
        .nav-item i { font-size: 1.2rem; margin-bottom: 2px; }

        /* Lesson Grid List (200 Lessons) */
        .lesson-list-container {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 380px;
            overflow-y: auto;
            padding-right: 4px;
        }

        .lesson-card-item {
            background: white;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 10px 12px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s;
        }

        .lesson-card-item:hover {
            border-color: var(--primary-color);
            background: var(--primary-light);
        }

        .lesson-card-item.locked {
            opacity: 0.6;
            background: #F1F5F9;
            cursor: not-allowed;
        }

        .difficulty-pill {
            font-size: 0.62rem;
            padding: 2px 6px;
            border-radius: 10px;
            font-weight: 700;
        }
        .diff-easy { background: #E0F2FE; color: #0369A1; }
        .diff-mid { background: #FEF3C7; color: #B45309; }
        .diff-hard { background: #FEE2E2; color: #B91C1C; }

        .mcq-option {
            background: #F8FAFC;
            border: 1px solid var(--border-color);
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-dark);
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .mcq-option:hover {
            border-color: var(--primary-color);
            background: var(--primary-light);
        }

        .mcq-option.selected-correct {
            background: #DCFCE7;
            border-color: #10B981;
            color: #15803D;
        }

        .mcq-option.selected-wrong {
            background: #FEE2E2;
            border-color: #EF4444;
            color: #B91C1C;
        }
    </style>
</head>
<body>

<div class="phone-container">
    <!-- Header -->
    <div class="app-header">
        <div class="app-title"><i class="fa-solid fa-graduation-cap"></i> Lynh English 200</div>
        <div class="flex items-center gap-2">
            <button id="audio-toggle-btn" onclick="toggleAudioEngine()" class="bg-white/20 hover:bg-white/30 text-white text-xs px-2.5 py-1 rounded-full flex items-center gap-1.5 transition">
                <i class="fa-solid fa-volume-high" id="audio-icon"></i> <span id="audio-status">Bật Âm Thanh</span>
            </button>
            <div class="user-level-badge" id="current-level-tag">3.5 - 6.5 IELTS</div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="app-body">

        <!-- DASHBOARD -->
        <div id="screen-dashboard" class="screen active">
            <div class="section-title">
                <span><i class="fa-solid fa-layer-group" style="color:var(--primary-color)"></i> Trình Độ Curriculum (200 Bài/Bậc)</span>
            </div>
            <div class="level-selector">
                <div class="level-card" onclick="selectLevel('basic', '< 3.0 IELTS')">
                    <h4>Cơ Bản</h4>
                    <p>&lt; 3.0 (Mất gốc)</p>
                </div>
                <div class="level-card active" onclick="selectLevel('medium', '3.5 - 6.5 IELTS')">
                    <h4>Trung Bình</h4>
                    <p>3.5 - 6.5 IELTS</p>
                </div>
                <div class="level-card" onclick="selectLevel('advanced', '> 6.5 IELTS')">
                    <h4>Nâng Cao</h4>
                    <p>&gt; 6.5 IELTS</p>
                </div>
            </div>

            <!-- Topic Categories -->
            <div class="section-title">
                <span><i class="fa-solid fa-bookmark" style="color:var(--accent-color)"></i> Bộ Lọc Chủ Đề Bài Học</span>
            </div>
            <div class="topic-scroll">
                <div class="topic-chip active" onclick="filterTopic('all', this)"><i class="fa-solid fa-border-all"></i> Tất cả</div>
                <div class="topic-chip" onclick="filterTopic('daily', this)"><i class="fa-solid fa-mug-hot"></i> Giao tiếp</div>
                <div class="topic-chip" onclick="filterTopic('business', this)"><i class="fa-solid fa-briefcase"></i> Công sở</div>
                <div class="topic-chip" onclick="filterTopic('travel', this)"><i class="fa-solid fa-plane"></i> Du lịch</div>
                <div class="topic-chip" onclick="filterTopic('interview', this)"><i class="fa-solid fa-user-tie"></i> Phỏng vấn</div>
                <div class="topic-chip" onclick="filterTopic('academic', this)"><i class="fa-solid fa-book"></i> Academic</div>
            </div>

            <div class="section-title">
                <span><i class="fa-solid fa-bolt" style="color:#10B981"></i> Chọn Kỹ Năng Luyện Tập</span>
            </div>
            <div class="skills-grid">
                <div class="skill-card skill-listening" onclick="openSkillSelector('listening')">
                    <div class="skill-icon"><i class="fa-solid fa-headphones"></i></div>
                    <div class="skill-info">
                        <h3>Listening Practice (200 Bài)</h3>
                        <p>Nghe hội thoại, điền từ & phản xạ 20 câu/bài</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-slate-400 text-xs"></i>
                </div>

                <div class="skill-card skill-reading" onclick="openSkillSelector('reading')">
                    <div class="skill-icon"><i class="fa-solid fa-book-open"></i></div>
                    <div class="skill-info">
                        <h3>Reading Practice (200 Bài)</h3>
                        <p>Đọc hiểu, phát âm chuẩn & trắc nghiệm 20 câu</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-slate-400 text-xs"></i>
                </div>

                <div class="skill-card skill-writing" onclick="openSkillSelector('writing')">
                    <div class="skill-icon"><i class="fa-solid fa-pen-nib"></i></div>
                    <div class="skill-info">
                        <h3>Writing Practice (200 Bài)</h3>
                        <p>Viết câu, Email, Essay tăng độ khó 20 câu</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-slate-400 text-xs"></i>
                </div>

                <div class="skill-card skill-call" onclick="openSkillSelector('call')">
                    <div class="skill-icon"><i class="fa-solid fa-phone-volume"></i></div>
                    <div class="skill-info">
                        <h3>AI Voice Call Simulator</h3>
                        <p>Thực hành giao tiếp 20 tình huống phản xạ</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-slate-400 text-xs"></i>
                </div>
            </div>
        </div>

        <!-- LESSON LIST CATALOG SCREEN -->
        <div id="screen-catalog" class="screen">
            <button onclick="showScreen('dashboard')" class="text-indigo-600 font-semibold mb-3 flex items-center gap-2 text-xs"><i class="fa-solid fa-arrow-left"></i> Quay lại Menu Kỹ Năng</button>
            <div class="section-title">
                <span id="catalog-title">📚 Danh Sách 200 Bài Học</span>
                <span class="text-xs font-normal text-slate-500" id="catalog-count">200 bài</span>
            </div>

            <div class="relative mb-3">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                <input type="text" id="lesson-search-input" onkeyup="searchLessons()" placeholder="Tìm kiếm bài 1 - 200 hoặc tên bài..." class="w-full pl-8 pr-3 py-1.5 text-xs border border-slate-200 rounded-xl outline-none focus:border-indigo-500">
            </div>

            <div class="lesson-list-container" id="lesson-catalog-list">
                <!-- Dynamically generated 200 lessons -->
            </div>
        </div>

        <!-- LESSON RUNNER SCREEN (20 ITEMS PER LESSON) -->
        <div id="screen-runner" class="screen">
            <div class="flex justify-between items-center mb-2">
                <button onclick="confirmExitRunner()" class="text-slate-500 font-semibold flex items-center gap-1 text-xs hover:text-rose-600 transition"><i class="fa-solid fa-arrow-left-long"></i> Thoát bài học</button>
                <div class="text-xs font-bold text-indigo-600" id="runner-lesson-title">Bài 1/200</div>
                <div class="speed-btn" onclick="changeSpeed()" id="speed-btn">1.0x</div>
            </div>

            <!-- Progress Bar -->
            <div class="w-full bg-slate-200 rounded-full h-2 mb-2">
                <div class="bg-indigo-600 h-2 rounded-full transition-all duration-300" id="runner-progress-bar" style="width: 5%;"></div>
            </div>

            <div class="flex justify-between items-center text-xs text-slate-500 mb-2 font-semibold">
                <span>Câu hỏi <strong id="current-q-num" class="text-indigo-600">1</strong>/20</span>
                <span class="difficulty-pill diff-easy" id="current-q-diff">Độ khó: 1/20</span>
            </div>

            <!-- 30s Countdown Timer Banner -->
            <div class="flex items-center justify-between bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-xl mb-2 text-xs">
                <span class="text-amber-800 font-medium flex items-center gap-1.5">
                    <i class="fa-solid fa-hourglass-half animate-spin text-amber-600"></i>
                    Gợi ý AI tự động sau:
                </span>
                <span class="font-extrabold text-amber-700 bg-amber-200/80 px-2 py-0.5 rounded-md" id="inactivity-timer-text">30s</span>
            </div>

            <div class="interactive-box" id="question-card-body">
                <!-- Question Content Injected via JS -->
            </div>

            <!-- Smart 30s Inactivity Hint Card -->
            <div id="smart-hint-card" class="bg-amber-50/90 border border-amber-300 rounded-xl p-3 mb-2 text-xs shadow-sm transition-all duration-300" style="display:none;">
                <div class="flex items-center justify-between text-amber-900 font-bold mb-1">
                    <span class="flex items-center gap-1.5"><i class="fa-solid fa-lightbulb text-amber-500 text-sm"></i> Gợi ý Từ Khóa (AI Keyword Hint)</span>
                    <button onclick="dismissHintCard()" class="text-amber-700 text-[10px] bg-amber-200/60 hover:bg-amber-200 px-1.5 py-0.5 rounded">Ẩn</button>
                </div>
                <div class="text-slate-700 space-y-1" id="smart-hint-content">
                    <!-- Hint details -->
                </div>
            </div>

            <div id="runner-feedback" class="ai-feedback" style="display:none;"></div>

            <!-- Navigation Bar inside Runner (Prev / Skip / Submit / Next) -->
            <div class="mt-3 flex gap-2">
                <button id="btn-prev-q" onclick="prevQuestion()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-semibold border border-slate-200 text-xs transition flex items-center gap-1">
                    <i class="fa-solid fa-chevron-left"></i> Câu trước
                </button>
                <button id="btn-submit-q" onclick="submitCurrentAnswer()" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold shadow-md shadow-indigo-200 text-xs transition">Kiểm Tra Câu Này</button>
                <button id="btn-skip-q" onclick="skipQuestion()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl font-semibold border border-slate-200 text-xs transition">Bỏ qua</button>
                <button id="btn-next-q" onclick="nextQuestion()" class="flex-1 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-semibold shadow-md shadow-emerald-200 text-xs transition" style="display:none;">Câu Tiếp Theo <i class="fa-solid fa-arrow-right ml-1"></i></button>
            </div>
        </div>

        <!-- LESSON RESULT SUMMARY SCREEN -->
        <div id="screen-result" class="screen">
