        stopInactivityTimer();
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.getElementById(`screen-${screenId}`).classList.add('active');

        if (screenId === 'progress') {
            renderProgressStats();
        }
    }

    function switchNav(navKey) {
        document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
        const activeNav = document.getElementById(`nav-item-${navKey}`);
        if (activeNav) activeNav.classList.add('active');
        showScreen(navKey);
    }

    function selectLevel(level, label) {
        playEffect('click');
        currentLevel = level;
        document.getElementById('current-level-tag').innerText = label;
        document.querySelectorAll('.level-card').forEach(c => c.classList.remove('active'));
        event.currentTarget.classList.add('active');
        if (document.getElementById('screen-catalog').classList.contains('active')) {
            renderLessonCatalog();
        }
    }

    function filterTopic(topic, element) {
        playEffect('click');
        currentTopic = topic;
        document.querySelectorAll('.topic-chip').forEach(c => c.classList.remove('active'));
        element.classList.add('active');
        if (document.getElementById('screen-catalog').classList.contains('active')) {
            renderLessonCatalog();
        }
    }

    function openSkillSelector(skill) {
        playEffect('click');
        currentSkill = skill;
        if (skill === 'call') {
            startCall();
            return;
        }
        const skillTitles = {
            listening: '🎧 200 Bài Luyện Nghe (Listening)',
            reading: '📖 200 Bài Đọc Hiểu (Reading)',
            writing: '✍️ 200 Bài Luyện Viết (Writing)',
            call: '📞 200 Tình Huống AI Call'
        };
        document.getElementById('catalog-title').innerText = skillTitles[skill];
        showScreen('catalog');
        renderLessonCatalog();
    }

    // RENDER 200 LESSON CATALOG LIST
    function renderLessonCatalog() {
        const lessons = DATABASE[currentLevel].filter(l => currentTopic === 'all' || l.topic === currentTopic);
        const container = document.getElementById('lesson-catalog-list');
        document.getElementById('catalog-count').innerText = `${lessons.length} bài`;

        if (lessons.length === 0) {
            container.innerHTML = `<div class="text-xs text-slate-400 italic p-4 text-center">Không tìm thấy bài học phù hợp.</div>`;
            return;
        }

        container.innerHTML = lessons.map(l => {
            const diffClass = l.difficulty <= 6 ? 'diff-easy' : (l.difficulty <= 14 ? 'diff-mid' : 'diff-hard');
            const diffLabel = l.difficulty <= 6 ? 'Dễ' : (l.difficulty <= 14 ? 'Trung bình' : 'Khó');

            return `
                <div class="lesson-card-item ${!l.isUnlocked ? 'locked' : ''}" onclick="startLesson('${l.id}')">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold text-slate-800">${l.title}</span>
                            <span class="difficulty-pill ${diffClass}">${diffLabel}</span>
                        </div>
                        <div class="text-[10px] text-slate-500 mt-0.5">20 câu hỏi • Tiến độ: ${l.progress}% • Điểm: ${l.score}</div>
                    </div>
                    <div>
                        ${l.isUnlocked 
                            ? `<i class="fa-solid fa-circle-play text-indigo-600 text-lg"></i>` 
                            : `<i class="fa-solid fa-lock text-slate-400 text-sm"></i>`}
                    </div>
                </div>
            `;
        }).join('');
    }

    function searchLessons() {
        const query = document.getElementById('lesson-search-input').value.toLowerCase();
        const items = document.querySelectorAll('.lesson-card-item');
        items.forEach(item => {
            const text = item.innerText.toLowerCase();
            item.style.display = text.includes(query) ? 'flex' : 'none';
        });
    }

    // SMART 30-SECOND INACTIVITY HINT ENGINE
    function startInactivityTimer() {
        stopInactivityTimer();
        countdownSeconds = 30;
        document.getElementById('inactivity-timer-text').innerText = '30s';
        document.getElementById('smart-hint-card').style.display = 'none';

        inactivityTimer = setInterval(() => {
            countdownSeconds--;
            document.getElementById('inactivity-timer-text').innerText = `${countdownSeconds}s`;

            if (countdownSeconds <= 0) {
                clearInterval(inactivityTimer);
                showSmartHint();
            }
        }, 1000);
    }

    function stopInactivityTimer() {
        if (inactivityTimer) {
            clearInterval(inactivityTimer);
            inactivityTimer = null;
        }
    }

    function resetInactivityOnUserAction() {
        if (document.getElementById('smart-hint-card').style.display === 'none') {
            startInactivityTimer();
        }
    }

    function showSmartHint() {
        if (!activeLessonObj) return;
        playEffect('ring');
        const qData = activeLessonObj.items[currentQuestionIndex];
        const card = document.getElementById('smart-hint-card');
        const content = document.getElementById('smart-hint-content');

        content.innerHTML = `
            <div>• <b>Keyword cốt lõi:</b> <span class="text-indigo-600 font-bold">${qData.vocab.en}</span> (${qData.vocab.p} - ${qData.vocab.vi})</div>
            <div>• <b>Cấu trúc gợi ý:</b> S + should/can + <u class="text-amber-700">${qData.vocab.en}</u> + O</div>
            <div>• <b>Từ đồng nghĩa/Gần nghĩa:</b> <span class="italic text-slate-600">${qData.vocab.en} key term</span></div>
        `;

        card.style.display = 'block';
    }

    function dismissHintCard() {
        playEffect('click');
        document.getElementById('smart-hint-card').style.display = 'none';
        startInactivityTimer();
    }

    // START A LESSON (RUNNER ENGINE - 20 QUESTIONS)
    function startLesson(lessonId) {
        initAudioContext();
        const lesson = DATABASE[currentLevel].find(l => l.id === lessonId);
        if (!lesson) return;

        if (!lesson.isUnlocked) {
            playEffect('error');
            alert('Bài học này chưa mở khóa. Hãy hoàn thành các bài trước!');
            return;
        }

        activeLessonObj = lesson;
        currentQuestionIndex = 0;
        userAnswers = [];
        document.getElementById('runner-lesson-title').innerText = `Bài ${lesson.lessonNum}/200`;
        
        showScreen('runner');
        renderQuestion(currentQuestionIndex);
    }

    function renderQuestion(qIndex) {
        stopAllAudio();
        startInactivityTimer();
        const qData = activeLessonObj.items[qIndex];
        document.getElementById('current-q-num').innerText = qIndex + 1;
        document.getElementById('current-q-diff').innerText = `Độ khó: ${qData.difficulty}/20`;
        document.getElementById('runner-progress-bar').style.width = `${((qIndex + 1) / 20) * 100}%`;

        document.getElementById('runner-feedback').style.display = 'none';
        document.getElementById('btn-submit-q').style.display = 'block';
        document.getElementById('btn-next-q').style.display = 'none';
        
        // Prev button visibility
        document.getElementById('btn-prev-q').style.opacity = (qIndex === 0) ? '0.5' : '1';
        document.getElementById('btn-prev-q').disabled = (qIndex === 0);

        activeSelectedMCQ = null;

        const card = document.getElementById('question-card-body');

        // Dynamic rendering according to current Skill
        if (currentSkill === 'listening') {
            card.innerHTML = `
                <div class="audio-player">
                    <button class="play-btn" onclick="speakText('${qData.listeningText.replace(/'/g, "\\'")}')"><i class="fa-solid fa-volume-high"></i></button>
                    <div style="flex:1">
                        <div style="font-size:0.8rem; font-weight:700; color:var(--text-dark);">Phát Âm Nghe Realtime</div>
                        <div style="font-size:0.68rem; color:var(--text-muted)">Bấm nút để nghe câu nói chuẩn ngữ điệu</div>
                    </div>
                </div>
                <p class="text-xs text-slate-700 font-semibold mb-2">Nghe và điền từ còn thiếu vào ô trống:</p>
                <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-xs text-slate-800 leading-relaxed">
                    "${qData.listeningText.replace(qData.blankWord, `<input type="text" id="q-input-text" oninput="resetInactivityOnUserAction()" class="w-24 px-2 py-0.5 border border-indigo-400 rounded text-indigo-700 font-bold outline-none text-center" placeholder="...">`)}"
                </div>
            `;
            // Auto play speech for listening item
            setTimeout(() => speakText(qData.listeningText), 300);

        } else if (currentSkill === 'reading') {
            card.innerHTML = `
                <div class="text-xs font-bold text-slate-700 mb-2">${qData.mcqQuestion}</div>
                <div class="flex flex-col gap-2">
                    ${qData.mcqOptions.map((opt, i) => `
                        <div class="mcq-option" id="mcq-opt-${i}" onclick="selectMCQOption(${i}, '${opt.replace(/'/g, "\\'")}')">
                            <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-600 font-bold text-[10px] flex items-center justify-center">${String.fromCharCode(65 + i)}</span>
                            <span>${opt}</span>
                        </div>
                    `).join('')}
                </div>
            `;
        } else if (currentSkill === 'writing') {
            card.innerHTML = `
                <p class="text-xs font-bold text-slate-700 mb-1">Dịch câu sau đây sang tiếng Anh:</p>
                <div class="bg-indigo-50 p-3 rounded-xl border border-indigo-100 text-xs text-indigo-900 font-semibold mb-3">
                    "${qData.writingPrompt}"
                </div>
                <textarea id="q-input-text" oninput="resetInactivityOnUserAction()" rows="3" class="w-full p-2.5 text-xs border border-slate-200 rounded-xl outline-none focus:border-indigo-500" placeholder="Nhập câu trả lời bằng tiếng Anh..."></textarea>
            `;
        } else { // Call
            card.innerHTML = `
                <div class="audio-player">
                    <button class="play-btn" onclick="speakText('${qData.listeningText.replace(/'/g, "\\'")}')"><i class="fa-solid fa-volume-high"></i></button>
                    <div style="flex:1">
                        <div style="font-size:0.8rem; font-weight:700; color:var(--text-dark);">AI Tutor Question</div>
                        <div style="font-size:0.68rem; color:var(--text-muted)">Phản xạ trả lời tình huống này</div>
                    </div>
                </div>
                <p class="text-xs text-slate-800 font-bold mb-2">"${qData.listeningText}"</p>
                <input type="text" id="q-input-text" oninput="resetInactivityOnUserAction()" class="w-full p-2.5 text-xs border border-slate-200 rounded-xl outline-none focus:border-indigo-500" placeholder="Nhập câu trả lời giao tiếp của bạn...">
            `;
            setTimeout(() => speakText(qData.listeningText), 300);
        }
    }

    function selectMCQOption(index, val) {
        resetInactivityOnUserAction();
        playEffect('click');
        activeSelectedMCQ = val;
        document.querySelectorAll('.mcq-option').forEach(el => {
            el.style.borderColor = "var(--border-color)";
            el.style.background = "#F8FAFC";
        });
        const target = document.getElementById(`mcq-opt-${index}`);
        if (target) {
            target.style.borderColor = "var(--primary-color)";
            target.style.background = "var(--primary-light)";
        }
    }

    function submitCurrentAnswer() {
        stopInactivityTimer();
        initAudioContext();
        const qData = activeLessonObj.items[currentQuestionIndex];
        const feedback = document.getElementById('runner-feedback');
        let isCorrect = false;
        let userVal = "";

        if (currentSkill === 'reading') {
            if (!activeSelectedMCQ) {
                alert('Vui lòng chọn 1 đáp án!');
                startInactivityTimer();
                return;
            }
            userVal = activeSelectedMCQ;
            isCorrect = (userVal === qData.correctMcq);
        } else {
            const inputEl = document.getElementById('q-input-text');
            if (!inputEl || !inputEl.value.trim()) {
                alert('Vui lòng nhập câu trả lời!');
                startInactivityTimer();
                return;
            }
            userVal = inputEl.value.trim();

            if (currentSkill === 'listening') {
                isCorrect = (userVal.toLowerCase() === qData.blankWord.toLowerCase());
            } else if (currentSkill === 'writing') {
                isCorrect = userVal.toLowerCase().includes(qData.vocab.en.toLowerCase());
            } else {
                isCorrect = userVal.length > 3;
            }
        }

        userAnswers.push({ qNum: currentQuestionIndex + 1, isCorrect: isCorrect, userVal: userVal });

        feedback.style.display = 'block';
        if (isCorrect) {
            playEffect('success');
            feedback.innerHTML = `
                <div class="text-emerald-700 font-bold"><i class="fa-solid fa-circle-check"></i> Chúc mừng! Đáp án chính xác.</div>
                <div class="text-slate-600 text-xs mt-1">${qData.explanation}</div>
            `;
            speakText("Correct! Well done.", 'en-US', 1.1);
        } else {
            playEffect('error');
            feedback.innerHTML = `
                <div class="text-rose-600 font-bold"><i class="fa-solid fa-circle-xmark"></i> Chưa chính xác!</div>
                <div class="text-slate-600 text-xs mt-1">Đáp án gợi ý: <b>"${qData.blankWord || qData.correctMcq || qData.writingCorrect}"</b>.<br>${qData.explanation}</div>
            `;
        }

        document.getElementById('btn-submit-q').style.display = 'none';
        document.getElementById('btn-next-q').style.display = 'block';
    }

    function prevQuestion() {
        playEffect('click');
        if (currentQuestionIndex > 0) {
            currentQuestionIndex--;
            renderQuestion(currentQuestionIndex);
        }
    }

    function skipQuestion() {
        playEffect('click');
        userAnswers.push({ qNum: currentQuestionIndex + 1, isCorrect: false, userVal: "Skipped" });
        nextQuestion();
    }

    function nextQuestion() {
        playEffect('click');
        currentQuestionIndex++;
        if (currentQuestionIndex < 20) {
            renderQuestion(currentQuestionIndex);
        } else {
            finishLesson();
        }
    }

    function finishLesson() {
        stopInactivityTimer();
        const correctCount = userAnswers.filter(a => a.isCorrect).length;
        activeLessonObj.progress = 100;
        activeLessonObj.score = `${correctCount}/20`;

        // Unlock next lesson
        const nextLesson = DATABASE[currentLevel].find(l => l.lessonNum === activeLessonObj.lessonNum + 1);
        if (nextLesson) nextLesson.isUnlocked = true;

        document.getElementById('result-lesson-name').innerText = activeLessonObj.title;
        document.getElementById('result-score').innerText = `${correctCount} / 20`;
        document.getElementById('result-percentage').innerText = `Đạt ${(correctCount / 20 * 100).toFixed(0)}% tỉ lệ đúng`;

        document.getElementById('result-details').innerHTML = `
            <div class="font-bold text-slate-700 mb-1">Thống kê chi tiết bài học:</div>
            <div>• Số câu đúng: <strong class="text-emerald-600">${correctCount} câu</strong></div>
            <div>• Số câu sai/cần ôn: <strong class="text-rose-500">${20 - correctCount} câu</strong></div>
            <div>• Độ khó hoàn thành: Level ${activeLessonObj.difficulty}/20</div>
            <div>• Bài tiếp theo (Bài ${activeLessonObj.lessonNum + 1}): <strong class="text-indigo-600">Đã mở khóa!</strong></div>
        `;

        showScreen('result');
        playEffect('success');
    }

    function restartCurrentLesson() {
        if (activeLessonObj) {
            startLesson(activeLessonObj.id);
        }
    }

    function confirmExitRunner() {
        stopAllAudio();
        stopInactivityTimer();
        if (confirm('Bạn có chắc muốn dừng bài học và quay lại danh sách bài tập?')) {
            showScreen('catalog');
        } else {
            startInactivityTimer();
        }
    }

    function changeSpeed() {
        playEffect('click');
        const speeds = [0.5, 0.75, 1.0, 1.25, 1.5];
        let idx = speeds.indexOf(currentSpeed);
        currentSpeed = speeds[(idx + 1) % speeds.length];
        document.getElementById('speed-btn').innerText = currentSpeed + 'x';
    }

    // AI Call System Functionalities
    function startCall() {
        initAudioContext();
        playEffect('ring');
        isCalling = true;
        document.getElementById('call-screen').classList.add('active');

        const initialGreeting = `Hello! I am Lynh. Welcome to our level ${currentLevel} conversation practice. Let's begin situation 1. How are you today?`;
        document.getElementById('transcript-box').innerHTML = `<div class="text-indigo-200">AI: "${initialGreeting}"</div>`;

        setTimeout(() => {
            speakText(initialGreeting, 'en-US', 1.0);
        }, 500);

        initSpeechRecognition();
    }

    function endCall() {
        playEffect('click');
        isCalling = false;
        stopAllAudio();
        if (speechRecognition) speechRecognition.stop();
        document.getElementById('call-screen').classList.remove('active');
        showScreen('dashboard');
    }

    function toggleMic() {
        playEffect('click');
        isMicActive = !isMicActive;
        const btn = document.getElementById('mic-btn');
        btn.style.background = isMicActive ? "#10B981" : "#64748B";
        btn.innerHTML = isMicActive ? '<i class="fa-solid fa-microphone"></i>' : '<i class="fa-solid fa-microphone-slash"></i>';

        if (isMicActive && speechRecognition) {
            try { speechRecognition.start(); } catch(e){}
        } else if (speechRecognition) {
            speechRecognition.stop();
        }
    }

    function getCallHint() {
        playEffect('click');
        const hints = [
            "I am doing great today, thanks for asking!",
            "I would like to practice speaking about business and work.",
            "Could you explain that sentence again please?"
        ];
        const randomHint = hints[Math.floor(Math.random() * hints.length)];
        const box = document.getElementById('transcript-box');
        box.innerHTML += `<div class="text-amber-300 mt-1">💡 <b>Gợi ý phản xạ:</b> "${randomHint}"</div>`;
        box.scrollTop = box.scrollHeight;
        speakText(randomHint, 'en-US', 0.9);
    }

    function initSpeechRecognition() {
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (SpeechRecognition) {
            speechRecognition = new SpeechRecognition();
            speechRecognition.lang = 'en-US';
            speechRecognition.continuous = false;
            speechRecognition.interimResults = false;

            speechRecognition.onresult = (event) => {
                const userSpeech = event.results[0][0].transcript;
                const box = document.getElementById('transcript-box');
                box.innerHTML += `<div class="text-emerald-300 font-semibold mt-1">You: "${userSpeech}"</div>`;
                box.scrollTop = box.scrollHeight;

                setTimeout(() => {
                    const replies = [
                        `That's very interesting! Tell me more about "${userSpeech}".`,
                        `Great pronunciation! Let's move to the next situation.`,
                        `I understand your point completely. What else would you like to discuss?`
                    ];
                    const aiReply = replies[Math.floor(Math.random() * replies.length)];
                    box.innerHTML += `<div class="text-indigo-200 mt-1">AI: "${aiReply}"</div>`;
                    box.scrollTop = box.scrollHeight;
                    speakText(aiReply, 'en-US', 1.0);
                }, 750);
            };

            speechRecognition.onend = () => {
                if (isCalling && isMicActive) {
                    try { speechRecognition.start(); } catch(e){}
                }
            };

            try { speechRecognition.start(); } catch(e){}
        }
    }

    // Render Stats for Progress Tab
    function renderProgressStats() {
        let completedCount = 0;
        const levels = ['basic', 'medium', 'advanced'];

        levels.forEach(lvl => {
            const unlocked = DATABASE[lvl].filter(l => l.isUnlocked).length;
            const completed = DATABASE[lvl].filter(l => l.progress === 100).length;
            completedCount += completed;

            const pct = ((unlocked / 200) * 100).toFixed(1);
            document.getElementById(`level-progress-${lvl}`).innerText = `${unlocked} / 200 bài`;
            document.getElementById(`level-bar-${lvl}`).style.width = `${pct}%`;
        });

        document.getElementById('stats-completed-count').innerText = `${completedCount} / 600`;
    }

    // Settings & Profile Helpers
    function updateProfileName() {
        const val = document.getElementById('user-name-input').value.trim();
        if (val) {
            document.getElementById('profile-display-name').innerText = val;
            playEffect('click');
        }
    }

    function updateVoiceSetting() {
        preferredVoiceLang = document.getElementById('setting-voice-accent').value;
        currentSpeed = parseFloat(document.getElementById('setting-voice-rate').value);
        playEffect('click');
        speakText("Voice settings updated successfully", preferredVoiceLang, currentSpeed);
    }

    function testSystemAudio() {
        initAudioContext();
        playEffect('success');
        speakText("Realtime audio system is functioning properly!", preferredVoiceLang, currentSpeed);
    }

    function resetLearningData() {
        if (confirm('Bạn có chắc muốn đặt lại tất cả dữ liệu bài học?')) {
            playEffect('error');
            ['basic', 'medium', 'advanced'].forEach(lvl => {
                DATABASE[lvl].forEach((l, idx) => {
                    l.isUnlocked = (idx < 5);
                    l.progress = 0;
                    l.score = '0/20';
                });
            });
            alert('Đã khôi phục cài đặt tiến độ bài học!');
            renderProgressStats();
        }
    }

    // Initialize App
    document.addEventListener('DOMContentLoaded', () => {
        renderLessonCatalog();
    });

    document.addEventListener('click', function initOnce() {
        initAudioContext();
        document.removeEventListener('click', initOnce);
    }, { once: true });
</script>
</body>
</html>
